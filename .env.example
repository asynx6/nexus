# NEXUS example environment. Copy to .env and fill in real values.
# .env is gitignored.

# Any OpenAI-compatible chat-completions base URL.
NEXUS_GATEWAY_BASE=https://api.asynx6.tech/v1

# Your API key for that gateway. NEVER commit real keys.
NEXUS_GATEWAY_KEY=

# Comma-separated fallback chain. First is default.
NEXUS_GATEWAY_MODELS=hermes-agent

# Optional: agent loop timeouts in ms. Defaults: provider 120_000, exec 60_000.
# NEXUS_AGENT_TIMEOUT_MS=120000
# NEXUS_EXEC_TIMEOUT_MS=60000
